"""
train_model.py

Trains a Random Forest on the preprocessed XJTU-SY feature CSV
(produced by preprocess.py) and evaluates RUL prediction performance.
"""

import os
import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.preprocessing import StandardScaler

FEATURES_CSV = r"A:\Coding\Bearing-RUL-Prediction\data\PROCESSED\xjtu_sy_features.csv"
NON_FEATURE_COLS = ["rul", "snapshot_idx", "split", "condition", "bearing"]

def load_data(csv_path: str) -> pd.DataFrame:
    if not os.path.exists(csv_path):
        raise FileNotFoundError(
            f"{csv_path} not found. Run preprocess.py first to generate it."
        )
    return pd.read_csv(csv_path)

def main():
    print(f"Loading features from {FEATURES_CSV} ...")
    data = load_data(FEATURES_CSV)
    print(f"Loaded {len(data)} rows, {data['bearing'].nunique()} bearings.")

    feature_cols = [c for c in data.columns if c not in NON_FEATURE_COLS]

    # Use the split already encoded in the filenames (train/test)
    train_df = data[data["split"] == "train"]
    test_df = data[data["split"] == "test"]

    if train_df.empty or test_df.empty:
        raise ValueError(
            "Train or test split is empty — check the 'split' column in the CSV."
        )

    print(f"Train bearings: {sorted(train_df['bearing'].unique())}")
    print(f"Test bearings:  {sorted(test_df['bearing'].unique())}")

    X_train, y_train = train_df[feature_cols], train_df["rul"]
    X_test, y_test = test_df[feature_cols], test_df["rul"]

    scaler = StandardScaler()
    X_train_scaled = scaler.fit_transform(X_train)
    X_test_scaled = scaler.transform(X_test)

    model = RandomForestRegressor(
        n_estimators=300,
        max_depth=None,
        min_samples_leaf=2,
        n_jobs=-1,
        random_state=42,
    )
    model.fit(X_train_scaled, y_train)

    preds = model.predict(X_test_scaled)

    mae = mean_absolute_error(y_test, preds)
    rmse = np.sqrt(mean_squared_error(y_test, preds))
    r2 = r2_score(y_test, preds)

    print("\n--- Evaluation ---")
    print(f"MAE:  {mae:.3f}")
    print(f"RMSE: {rmse:.3f}")
    print(f"R2:   {r2:.3f}")

    importances = pd.Series(model.feature_importances_, index=feature_cols)
    print("\nTop 10 features by importance:")
    print(importances.sort_values(ascending=False).head(10))

if __name__ == "__main__":
    main()